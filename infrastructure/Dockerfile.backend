# DevGuard AI - Backend (FastAPI + LangGraph orchestrator)
FROM python:3.12-slim

WORKDIR /app

# System deps needed by some scanners/tools used by CodeSec/DeployOps later
# (git for repo cloning, curl for healthchecks/debugging)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Alembic needs its config + migration scripts (at repo root) alongside src/.
# alembic/env.py appends '..' to sys.path and imports src.backend.models, so
# both must live in /app.
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY src/ ./src/

EXPOSE 8000

# Apply any pending schema migrations before starting the API.
CMD ["sh", "-c", "alembic upgrade head && uvicorn src.backend.main:app --host 0.0.0.0 --port 8000 --reload"]
