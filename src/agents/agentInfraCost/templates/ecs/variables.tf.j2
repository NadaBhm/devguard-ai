variable "region" {
  description = "AWS region to deploy into"
  type        = string
  default     = "{{ region }}"
}

variable "environment" {
  description = "Deployment environment"
  type        = string
  default     = "{{ environment }}"
}

# These are supplied by the pipeline from standing sandbox resources via the
# DEVGUARD_VPC_ID / DEVGUARD_SUBNET_IDS environment variables (merged into
# terraform.tfvars.json by DeployOps), or set manually before `terraform apply`.

variable "vpc_id" {
  description = "ID of an existing VPC to deploy the load balancer and ECS tasks into"
  type        = string
}

variable "subnet_ids" {
  description = "IDs of existing subnets (at least 2, in different availability zones) for the load balancer and ECS tasks"
  type        = list(string)
}
{% if database %}

# A "{{ database }}" database was detected in this repo. This module does
# NOT create one (a real database has a real recurring cost, and picking its
# size/engine version is a separate decision). The pipeline supplies these
# from a standing sandbox database via DEVGUARD_DB_* environment variables
# (DeployOps merges them into terraform.tfvars.json); a deployer can also set
# them manually before `terraform apply`. For production use, prefer AWS
# Secrets Manager over passing db_password as a plain Terraform variable.

variable "db_host" {
  description = "Hostname of an existing {{ database }} database"
  type        = string
}

variable "db_port" {
  description = "Port of an existing {{ database }} database"
  type        = number
}

variable "db_name" {
  description = "Database name to connect to"
  type        = string
}

variable "db_user" {
  description = "Database user"
  type        = string
}

variable "db_password" {
  description = "Database password"
  type        = string
  sensitive   = true
}
{% endif %}
