terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region
}

resource "aws_ecs_cluster" "this" {
  name = "{{ cluster_name }}"
}

# Fargate tasks use "awsvpc" networking, which requires an explicit VPC/subnet
# placement (there is no default network for Fargate the way there is for
# EC2-backed ECS). vpc_id/subnet_ids are declared as required variables in
# variables.tf.j2 -- this module deploys INTO an existing VPC, it does not
# create one itself.
resource "aws_security_group" "alb" {
  name   = "{{ service_name }}-alb"
  vpc_id = var.vpc_id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "ecs_tasks" {
  name   = "{{ service_name }}-tasks"
  vpc_id = var.vpc_id

  # Only the load balancer, never the open internet, may reach the container
  # port directly.
  ingress {
    from_port       = {{ health_check_port }}
    to_port         = {{ health_check_port }}
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_lb" "this" {
  name               = "{{ service_name }}-alb"
  internal           = false
  load_balancer_type = "application"
  subnets            = var.subnet_ids
  security_groups    = [aws_security_group.alb.id]
}

resource "aws_lb_target_group" "this" {
  name        = "{{ service_name }}-tg"
  port        = {{ health_check_port }}
  protocol    = "HTTP"
  vpc_id      = var.vpc_id
  target_type = "ip" # required for Fargate tasks (no static EC2 instance to attach)

  health_check {
    path                = "{{ health_check_path }}"
    port                = "traffic-port"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    timeout             = 5
    interval            = 30
  }
}

resource "aws_lb_listener" "this" {
  load_balancer_arn = aws_lb.this.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.this.arn
  }
}

# Fargate tasks need an IAM execution role so ECS can pull the image from ECR
# and write container logs to CloudWatch. Without it `terraform apply` fails
# with "InvalidParameterException: Missing required position 'executionRoleArn'"
# for ECR-hosted images and with no ability to stream logs.
resource "aws_iam_role" "ecs_task_execution" {
  name = "{{ execution_role_name }}"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "ecs_task_execution" {
  role       = aws_iam_role.ecs_task_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_cloudwatch_log_group" "ecs" {
  name              = "{{ log_group_name }}"
  retention_in_days = 30
}

resource "aws_ecs_task_definition" "this" {
  family                   = "{{ service_name }}"
  requires_compatibilities = ["FARGATE"]
  network_mode              = "awsvpc"
  cpu                       = "{{ task_cpu }}"
  memory                    = "{{ task_memory }}"
  execution_role_arn        = aws_iam_role.ecs_task_execution.arn

  container_definitions = jsonencode([
    {
      name  = "{{ service_name }}"
      image = "{{ docker_image }}"
      portMappings = [
        {
          containerPort = {{ health_check_port }}
          protocol      = "tcp"
        }
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = "{{ log_group_name }}"
          "awslogs-region"        = var.region
          "awslogs-stream-prefix" = "ecs"
        }
      }
{% if database %}
      # A "{{ database }}" database was detected in this repo. No database is
      # created by this module (that's a separate decision, with a real
      # recurring cost) -- these variables just give the container a place
      # to receive real connection details, supplied at apply-time.
      environment = [
        { name = "DB_ENGINE", value = "{{ database }}" },
        { name = "DB_HOST", value = var.db_host },
        { name = "DB_PORT", value = tostring(var.db_port) },
        { name = "DB_NAME", value = var.db_name },
        { name = "DB_USER", value = var.db_user },
        { name = "DB_PASSWORD", value = var.db_password },
      ]
{% endif %}
    }
  ])
}

resource "aws_ecs_service" "this" {
  name            = "{{ service_name }}"
  cluster         = aws_ecs_cluster.this.id
  task_definition = aws_ecs_task_definition.this.arn
  desired_count   = 1
  launch_type     = "FARGATE"

  # Required for Fargate ("awsvpc" mode): without this block, `terraform
  # apply` fails outright -- Fargate has no default network to fall back to.
  # assign_public_ip = true assumes var.subnet_ids are public subnets (the
  # simplest working setup); set it to false and add a NAT gateway if
  # deploying into private subnets instead.
  network_configuration {
    subnets          = var.subnet_ids
    security_groups  = [aws_security_group.ecs_tasks.id]
    assign_public_ip = true
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.this.arn
    container_name   = "{{ service_name }}"
    container_port   = {{ health_check_port }}
  }

  depends_on = [aws_lb_listener.this]
}
