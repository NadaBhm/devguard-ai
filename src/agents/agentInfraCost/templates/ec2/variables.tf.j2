variable "region" {
  description = "AWS region to deploy into"
  type        = string
  default     = "{{ region }}"
}

variable "environment" {
  description = "Deployment environment"
  type        = string
  default     = "{{ environment }}"
}

# Supplied by the pipeline from the standing sandbox VPC (DEVGUARD_VPC_ID /
# DEVGUARD_SUBNET_ID) and merged into terraform.tfvars.json by DeployOps.
variable "vpc_id" {
  description = "ID of an existing VPC to launch the instance into"
  type        = string
}

variable "subnet_id" {
  description = "ID of an existing public subnet to launch the instance into"
  type        = string
}
