.github
.venv
**/__pycache__
**/*.pyc
**/node_modules
**/dist
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
*.sqlite3
*.db
reports/
.pytest_cache
.devcontainer
*.log
.env
.env.*
!.env.example
