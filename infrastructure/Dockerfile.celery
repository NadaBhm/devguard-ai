# DevGuard AI - Celery worker (async agent execution)
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

# NOTE: entrypoint assumes the Celery app object lives at
# src/backend/celery_app.py as "celery_app".
CMD ["celery", "-A", "src.backend.celery_app", "worker", "--loglevel=info"]
