# DevGuard AI - Environment Variables Example

# --- PostgreSQL (T-1.3) ---
# The docker-compose postgres service publishes on host port 5433 so it never
# collides with a native/Homebrew Postgres that already occupies 5432 (which
# would otherwise silently shadow the container). If you only use the native
# instance, point DATABASE_URL at it and leave the user matching that instance.
POSTGRES_USER=devguard
POSTGRES_PASSWORD=devguard
POSTGRES_DB=devguard
POSTGRES_PORT=5433

# SQLAlchemy connection string. Defaults to the docker-compose postgres above.
# For a native instance replace with e.g. postgresql://<your-user>@localhost:5432/devguard
DATABASE_URL=postgresql://devguard:devguard@localhost:5433/devguard

# --- Redis (T-1.4) ---
REDIS_PORT=6379

# --- Qdrant (T-1.11) ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Backend / Frontend ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- API auth (T-1.5) ---
API_KEY=change-me-in-real-env

# --- JWT signing secret (REQUIRED) ---
SECRET_KEY=

# --- CORS allowed origins (JSON list) ---
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- LLM providers (Orchestrator chat, RAG, US-2.2.5) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- AWS (InfraCost / DeployOps agents, Sprint 2+) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Standing sandbox network/database consumed by generated Terraform modules.
# DeployOps merges these into terraform.tfvars.json before `terraform plan`
# so required variables (vpc_id, subnet_ids, db_*) never block on input.
# SUBNET_IDS is a comma-separated list of at least two subnets (different AZs).
DEVGUARD_VPC_ID=
DEVGUARD_SUBNET_IDS=
DEVGUARD_DB_HOST=
DEVGUARD_DB_PORT=5432
DEVGUARD_DB_NAME=
DEVGUARD_DB_USER=
DEVGUARD_DB_PASSWORD=

# --- Misc ---
LOG_LEVEL=INFO
ENVIRONMENT=development
