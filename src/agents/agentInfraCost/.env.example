# GEMINI_API_KEY is optional. Without it, core/llm_enrichment.py automatically
# falls back to static text templates — the pipeline works end-to-end either way.
GEMINI_API_KEY=

# OPENROUTER_API_KEY is optional. Without it, core/llm_architecture_advisor.py
# and core/llm_deployment_advisor.py automatically fall back to
# decision_engine.py's deterministic scoring and to "us-east-1"/"dev" —
# the pipeline works end-to-end either way. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPENROUTER_MODEL is optional — defaults to openai/gpt-4o-mini
# (see core/llm_provider.py). Any OpenRouter model slug works, e.g.
# anthropic/claude-3.5-sonnet.
OPENROUTER_MODEL=

# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are optional. Without them,
# core/aws_pricing_client.py automatically falls back to the static table in
# data/aws_pricing.json — the pipeline works end-to-end either way. boto3
# reads these two standard variable names itself; nothing else in this repo
# needs to reference them directly.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
