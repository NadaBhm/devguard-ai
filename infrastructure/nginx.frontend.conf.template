server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # gzip already-compressed static assets Vite emits (js/css)
    gzip on;
    gzip_types text/css application/javascript application/json;

    location /api/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s; # long-lived job-progress connections
    }

    # React Router uses real browser history (createBrowserRouter) -- a
    # direct request for e.g. /runs/abc123 must still serve index.html and
    # let the client-side router take over, or nginx would 404 it.
    location / {
        try_files $uri /index.html;
    }
}
