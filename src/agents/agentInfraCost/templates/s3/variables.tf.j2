variable "region" {
  description = "AWS region to deploy into"
  type        = string
  default     = "{{ region }}"
}

variable "environment" {
  description = "Deployment environment"
  type        = string
  default     = "{{ environment }}"
}

variable "bucket_name" {
  description = "Globally unique S3 bucket name (derived from the job id)"
  type        = string
}
