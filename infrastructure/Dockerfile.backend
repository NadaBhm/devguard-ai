# DevGuard AI - Backend (FastAPI + LangGraph orchestrator)
FROM python:3.12-slim

WORKDIR /app

# lib.rag.* (RAG ingestion/chat) lives under src/, so /app/src must be on the
# path for `from lib.rag... import ...` inside the codesec agent and chat API.
ENV PYTHONPATH=/app/src

# System deps needed by some scanners/tools used by CodeSec/DeployOps later
# (git for repo cloning, curl for healthchecks/debugging). Binary assets
# (awscli, gitleaks, trivy, hadolint) have arch-specific names, so pick the
# right suffix from the image arch instead of assuming x86_64.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    unzip \
    ca-certificates \
    gnupg \
    && case "$(dpkg --print-architecture)" in \
         amd64) AWS=linux-x86_64; GITLEAKS=linux_x64; TRIVY=Linux-64bit; HADOLINT=Linux-x86_64 ;; \
         arm64) AWS=linux-aarch64; GITLEAKS=linux_arm64; TRIVY=Linux-ARM64; HADOLINT=Linux-arm64 ;; \
         *) echo "Unsupported architecture: $(dpkg --print-architecture)"; exit 1 ;; \
       esac \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /etc/apt/keyrings/hashicorp.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com bookworm main" > /etc/apt/sources.list.d/hashicorp.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli terraform \
    && rm -rf /var/lib/apt/lists/* \
    && curl "https://awscli.amazonaws.com/awscli-exe-$AWS.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws \
    && curl -sSfL https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_8.30.1_$GITLEAKS.tar.gz -o gitleaks.tar.gz \
    && tar -xzf gitleaks.tar.gz gitleaks \
    && install -m 0755 gitleaks /usr/local/bin/gitleaks \
    && rm -f gitleaks.tar.gz gitleaks \
    && curl -sSfL https://github.com/aquasecurity/trivy/releases/latest/download/trivy_0.74.0_$TRIVY.tar.gz -o trivy.tar.gz \
    && tar -xzf trivy.tar.gz trivy \
    && install -m 0755 trivy /usr/local/bin/trivy \
    && rm -f trivy.tar.gz trivy \
    && curl -sSfL https://github.com/hadolint/hadolint/releases/latest/download/hadolint-$HADOLINT -o /usr/local/bin/hadolint \
    && chmod +x /usr/local/bin/hadolint
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Real CodeSec scanner deps (semgrep, bandit, pip-audit, safety, cyclonedx-bom).
# CLI tools these provide are invoked via subprocess by src/agents/codesec.
COPY src/agents/codesec/requirements.txt ./codesec-requirements.txt
RUN pip install --no-cache-dir -r codesec-requirements.txt

# Alembic needs its config + migration scripts (at repo root) alongside src/.
# alembic/env.py appends '..' to sys.path and imports src.backend.models, so
# both must live in /app.
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY src/ ./src/

EXPOSE 8000

# Apply any pending schema migrations before starting the API.
CMD ["sh", "-c", "alembic upgrade head && uvicorn src.backend.main:app --host 0.0.0.0 --port 8000 --reload"]
